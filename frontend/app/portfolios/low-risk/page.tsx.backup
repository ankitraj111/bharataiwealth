"use client"

import { useState, useEffect } from "react"
import { AppShell } from "@/components/app-shell"
import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card"
import { Button } from "@/components/ui/button"
import { Badge } from "@/components/ui/badge"
import { motion } from "framer-motion"
import {
  TrendingUp,
  Shield,
  ArrowUpRight,
  PiggyBank,
  Target,
  Brain,
  Sparkles,
  CheckCircle2,
  Info,
  Plus,
  Eye,
  X
} from "lucide-react"
import { Input } from "@/components/ui/input"
import { PieChart as RechartsPie, Pie, Cell, ResponsiveContainer, AreaChart, Area, XAxis, YAxis, Tooltip } from "recharts"
import { fetchPortfolioAssets } from "@/lib/api"
import { staggerContainer, scrollReveal, defaultViewport } from "@/lib/animation-variants"

// Low Risk Assets
const defaultAssets = [
  { name: "SBI Bluechip Fund", type: "Large Cap MF", value: 150000, return: 8.5, confidence: 85, risk: "Low", change: 2.3 },
  { name: "HDFC Top 100", type: "Large Cap MF", value: 120000, return: 7.2, confidence: 82, risk: "Low", change: 1.8 },
  { name: "Axis Liquid Fund", type: "Debt Fund", value: 200000, return: 5.8, confidence: 92, risk: "Very Low", change: 0.4 },
  { name: "PPF Account", type: "Fixed Income", value: 100000, return: 7.1, confidence: 100, risk: "Very Low", change: 0 },
  { name: "Govt Bonds (2028)", type: "Bonds", value: 80000, return: 6.5, confidence: 95, risk: "Very Low", change: 0.2 },
  { name: "ICICI Corporate Bond", type: "Debt Fund", value: 60000, return: 6.8, confidence: 88, risk: "Low", change: 0.5 },
]

const allocationData = [
  { name: "Large Cap MF", value: 37, color: "#0A66C2" },
  { name: "Debt Funds", value: 16, color: "#16A34A" },
  { name: "Fixed Income", value: 14, color: "#6366f1" },
  { name: "Bonds", value: 13, color: "#FF8C00" },
]

const performanceData = Array.from({ length: 12 }, (_, i) => ({
  month: ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"][i],
  value: 650000 + (i * 8000) + (Math.random() * 5000)
}))

const sipRecommendations = [
  { fund: "SBI Bluechip Fund", amount: 10000, frequency: "Monthly" },
  { fund: "Axis Liquid Fund", amount: 5000, frequency: "Monthly" },
]

export default function LowRiskPortfolioPage() {
  const [assets, setAssets] = useState(defaultAssets)
  const [showAddModal, setShowAddModal] = useState(false)

  useEffect(() => {
    fetchPortfolioAssets("low").then(data => {
      if (data?.assets?.length > 0) setAssets(data.assets)
    })
  }, [])

  const totalValue = assets.reduce((sum, asset) => sum + asset.value, 0)
  const avgReturn = assets.length > 0 ? assets.reduce((sum, asset) => sum + asset.return, 0) / assets.length : 0

  return (
    <AppShell>
      <motion.div
        className="space-y-10 pb-20"
        initial="hidden"
        animate="visible"
        variants={staggerContainer}
      >
        {/* Hero Header Section */}
        <motion.div className="flex flex-col md:flex-row md:items-end justify-between gap-6" variants={scrollReveal}>
          <div className="space-y-4">
            <div className="flex items-center gap-3">
              <div className="h-14 w-14 rounded-2xl bg-emerald-500/10 flex items-center justify-center border border-emerald-500/20">
                <Shield className="h-7 w-7 text-emerald-600 dark:text-emerald-400" />
              </div>
              <div>
                <Badge className="bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border-none text-xs font-semibold mb-1">Low Risk</Badge>
                <h1 className="text-4xl md:text-5xl font-semibold tracking-tight text-foreground">Safe & Stable Portfolio</h1>
              </div>
            </div>
            <p className="text-muted-foreground text-lg border-l-2 border-emerald-500/30 pl-4">Focus on capital preservation and steady growth</p>
          </div>

          <div className="flex gap-4">
            <div className="p-4 rounded-2xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-center min-w-[140px]">
              <p className="text-xs text-muted-foreground mb-1">Confidence</p>
              <p className="text-2xl font-semibold text-emerald-600 dark:text-emerald-400">98.2%</p>
            </div>
            <div className="p-4 rounded-2xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-center min-w-[140px]">
              <p className="text-xs text-muted-foreground mb-1">Risk Level</p>
              <p className="text-2xl font-semibold text-blue-600 dark:text-blue-400">LOW</p>
            </div>
          </div>
        </motion.div>

        {/* Strategy Banner */}
        <motion.div variants={scrollReveal}>
          <Card className="border-emerald-500/30 bg-emerald-500/5 dark:bg-emerald-500/10">
            <CardContent className="p-6">
              <div className="flex flex-col md:flex-row items-center justify-between gap-6">
                <div className="flex items-center gap-4">
                  <div className="h-16 w-16 rounded-full bg-emerald-500 flex items-center justify-center">
                    <CheckCircle2 className="h-8 w-8 text-white" />
                  </div>
                  <div>
                    <h3 className="text-xl font-semibold text-emerald-900 dark:text-emerald-400">Capital Protection Enabled</h3>
                    <p className="text-sm text-emerald-700 dark:text-emerald-500 mt-1">AI-curated conservative assets with high security</p>
                  </div>
                </div>
                <div className="flex flex-col items-end gap-2">
                  <Badge className="bg-emerald-600 text-white px-4 py-1">Risk Score: 1.8/10</Badge>
                  <p className="text-xs text-emerald-600 dark:text-emerald-400">Verified Safe</p>
                </div>
              </div>
            </CardContent>
          </Card>
        </motion.div>

        {/* Key Stats Grid */}
        <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {[
            { label: "Total Value", value: `₹${(totalValue / 100000).toFixed(2)}L`, color: "emerald", sub: "Portfolio Balance" },
            { label: "Average Return", value: `+${avgReturn.toFixed(1)}%`, icon: TrendingUp, color: "emerald", sub: "Annual Growth" },
            { label: "Safety Level", value: "HIGH", icon: Shield, color: "emerald", isBadge: true, sub: "Risk Rating" },
            { label: "Total Assets", value: assets.length, color: "emerald", sub: "Investments" },
          ].map((stat, i) => (
            <motion.div key={i} variants={scrollReveal}>
              <Card className="border-emerald-500/20 bg-emerald-500/5 dark:bg-emerald-500/10 hover:border-emerald-500/40 transition-all h-full">
                <CardContent className="p-6">
                  <p className="text-xs text-muted-foreground mb-3">{stat.label}</p>
                  <div className="flex items-end justify-between">
                    <div>
                      {stat.isBadge ? (
                        <div className="flex items-center gap-2">
                          <p className="text-3xl font-semibold text-emerald-600 dark:text-emerald-400">{stat.value}</p>
                          <Shield className="h-6 w-6 text-emerald-500 dark:text-emerald-400" />
                        </div>
                      ) : (
                        <p className={`text-3xl font-semibold ${stat.icon ? "text-emerald-600 dark:text-emerald-400" : "text-foreground"}`}>{stat.value}</p>
                      )}
                      <p className="text-xs text-muted-foreground mt-1">{stat.sub}</p>
                    </div>
                    {stat.icon && !stat.isBadge && <stat.icon className="h-8 w-8 text-emerald-500/20 dark:text-emerald-400/20" />}
                  </div>
                </CardContent>
              </Card>
            </motion.div>
          ))}
        </div>

        {/* Tactical Deep Dive Charts */}
        <div className="grid lg:grid-cols-5 gap-8">
          {/* Allocation Matrix */}
          <motion.div className="lg:col-span-2" variants={scrollReveal}>
            <Card className="glass-card h-full border-blue-500/20 bg-blue-500/5">
              <CardHeader className="border-b border-white/10 bg-white/20 dark:bg-black/20">
                <CardTitle className="text-base font-black flex items-center gap-2 uppercase tracking-tight">
                  <PiggyBank className="h-4 w-4 text-[#0A66C2]" />
                  Internal Asset Weights
                </CardTitle>
              </CardHeader>
              <CardContent className="pt-8">
                <div className="h-[240px] relative group/pie">
                  <div className="absolute inset-0 flex items-center justify-center pointer-events-none">
                    <div className="text-center">
                      <p className="text-[8px] font-black text-muted-foreground uppercase tracking-widest">Stability</p>
                      <p className="text-2xl font-black text-[#0A66C2]">FIXED</p>
                    </div>
                  </div>
                  <ResponsiveContainer width="100%" height="100%">
                    <RechartsPie>
                      <Pie
                        data={allocationData}
                        cx="50%"
                        cy="50%"
                        innerRadius={70}
                        outerRadius={95}
                        dataKey="value"
                        paddingAngle={6}
                        stroke="none"
                      >
                        {allocationData.map((entry, i) => <Cell key={i} fill={entry.color} className="hover:opacity-80 transition-opacity outline-none" />)}
                      </Pie>
                      <Tooltip
                        contentStyle={{ borderRadius: '16px', border: '1px solid rgba(255,255,255,0.2)', backgroundColor: 'rgba(255,255,255,0.9)', backdropFilter: 'blur(10px)', boxShadow: '0 20px 40px -10px rgba(0,0,0,0.1)' }}
                        itemStyle={{ fontWeight: '900', textTransform: 'uppercase', fontSize: '10px' }}
                      />
                    </RechartsPie>
                  </ResponsiveContainer>
                </div>
                <div className="grid grid-cols-2 gap-4 mt-8">
                  {allocationData.map((item, i) => (
                    <div key={i} className="flex items-center gap-4 p-3 rounded-2xl bg-white/40 dark:bg-black/20 border border-white/50 dark:border-white/10 hover:border-blue-500/30 transition-all group">
                      <div className="h-3 w-3 rounded-full flex-shrink-0 group-hover:scale-125 transition-transform" style={{ backgroundColor: item.color }} />
                      <div className="min-w-0">
                        <p className="text-[9px] text-muted-foreground font-black uppercase truncate tracking-widest mb-0.5">{item.name}</p>
                        <p className="text-lg font-black tracking-tighter">{item.value}%</p>
                      </div>
                    </div>
                  ))}
                </div>
              </CardContent>
            </Card>
          </motion.div>

          {/* Performance Architecture */}
          <motion.div className="lg:col-span-3" variants={scrollReveal}>
            <Card className="glass-card h-full border-blue-500/20 bg-blue-500/5">
              <CardHeader className="border-b border-white/10 bg-white/20 dark:bg-black/20">
                <CardTitle className="text-base font-black flex items-center gap-2 uppercase tracking-tight">
                  <TrendingUp className="h-4 w-4 text-emerald-600" />
                  Wealth Trajectory Projection (12M)
                </CardTitle>
              </CardHeader>
              <CardContent className="pt-8">
                <div className="h-[300px]">
                  <ResponsiveContainer width="100%" height="100%">
                    <AreaChart data={performanceData}>
                      <defs>
                        <linearGradient id="premiumLowRiskGradient" x1="0" y1="0" x2="0" y2="1">
                          <stop offset="0%" stopColor="#10b981" stopOpacity={0.3} />
                          <stop offset="100%" stopColor="#10b981" stopOpacity={0} />
                        </linearGradient>
                      </defs>
                      <XAxis
                        dataKey="month"
                        axisLine={false}
                        tickLine={false}
                        tick={{ fontSize: 9, fill: '#64748b', fontWeight: '900', textTransform: 'uppercase' }}
                        dy={15}
                      />
                      <YAxis
                        axisLine={false}
                        tickLine={false}
                        tick={{ fontSize: 9, fill: '#64748b', fontWeight: '900' }}
                        tickFormatter={(v: any) => `₹${(Number(v || 0) / 100000).toFixed(1)}L`}
                      />
                      <Tooltip
                        contentStyle={{
                          borderRadius: '16px',
                          border: '1px solid rgba(255,255,255,0.2)',
                          backgroundColor: 'rgba(255,255,255,0.9)',
                          backdropFilter: 'blur(10px)',
                          boxShadow: '0 20px 40px -10px rgba(0,0,0,0.1)',
                          padding: '16px'
                        }}
                        labelStyle={{ fontWeight: '900', color: '#64748b', fontSize: '10px', textTransform: 'uppercase', marginBottom: '4px' }}
                        formatter={(v: any) => [`₹${(Number(v || 0) / 100000).toFixed(2)}L`, 'STRATEGIC VALUE']}
                      />
                      <Area
                        type="monotone"
                        dataKey="value"
                        stroke="#10b981"
                        strokeWidth={6}
                        fill="url(#premiumLowRiskGradient)"
                        animationDuration={2500}
                        dot={{ r: 4, stroke: '#10b981', strokeWidth: 2, fill: '#fff' }}
                        activeDot={{ r: 8, stroke: '#10b981', strokeWidth: 2, fill: '#fff', className: 'animate-pulse' }}
                      />
                    </AreaChart>
                  </ResponsiveContainer>
                </div>
                <div className="mt-8 p-4 rounded-2xl bg-white/40 dark:bg-black/20 border border-white/50 dark:border-white/10 flex items-center justify-between">
                  <div className="flex items-center gap-3">
                    <div className="h-2 w-10 rounded-full bg-emerald-500" />
                    <span className="text-[10px] font-black text-muted-foreground uppercase tracking-widest">Stable Core performance Analytics</span>
                  </div>
                  <Badge variant="outline" className="border-emerald-500/20 text-emerald-600 font-black text-[9px] uppercase">Alpha Verified</Badge>
                </div>
              </CardContent>
            </Card>
          </motion.div>
        </div>

        {/* Global Asset Registry */}
        <motion.div variants={scrollReveal}>
          <Card className="glass-card border-[#0A66C2]/20 bg-[#0A66C2]/5 overflow-hidden">
            <CardHeader className="flex flex-row items-center justify-between pb-6 border-b border-border/10 bg-muted/5">
              <CardTitle className="text-xl font-black flex items-center gap-2 uppercase tracking-tight">
                <Target className="h-5 w-5 text-[#0A66C2]" />
                Strategic Holdings Matrix
              </CardTitle>
              <div className="flex items-center gap-2">
                <Badge className="bg-[#0A66C2] text-white font-black uppercase text-[10px]">{assets.length} ACTIVE NODES</Badge>
                <Badge variant="outline" className="text-muted-foreground font-black uppercase text-[10px] tracking-widest">Stability Index: HIGH</Badge>
              </div>
            </CardHeader>
            <CardContent className="p-0">
              <div className="overflow-x-auto">
                <table className="w-full">
                  <thead>
                    <tr className="text-[10px] uppercase text-muted-foreground font-black tracking-[0.15em] border-b border-border/10">
                      <th className="text-left p-8">Asset Name</th>
                      <th className="text-right p-8 hidden sm:table-cell">Risk Classification</th>
                      <th className="text-right p-8">Current Valuation</th>
                      <th className="text-center p-8 hidden md:table-cell">Engine Confidence</th>
                      <th className="text-right p-8">Projected Yield</th>
                      <th className="text-center p-8">Action</th>
                    </tr>
                  </thead>
                  <tbody className="divide-y divide-border/10">
                    {assets.map((asset, i) => (
                      <tr key={i} className="group hover:bg-[#0A66C2]/[0.05] transition-all duration-300">
                        <td className="p-8">
                          <div className="flex flex-col gap-1.5">
                            <span className="font-black text-foreground text-sm group-hover:text-[#0A66C2] transition-colors uppercase tracking-tight">{asset.name}</span>
                            <div className="flex items-center gap-2">
                              <Badge variant="secondary" className="text-[9px] bg-emerald-500/10 text-emerald-600 border-none font-black uppercase tracking-widest px-2">{asset.type}</Badge>
                              <span className="text-[9px] font-bold text-muted-foreground uppercase opacity-50 px-1 border-l border-border/20">Node ID: L-{i + 100}</span>
                            </div>
                          </div>
                        </td>
                        <td className="text-right p-8 text-[10px] font-black group-hover:text-emerald-600 transition-colors uppercase hidden sm:table-cell">
                          <div className="inline-flex items-center gap-2">
                            <span className="h-1.5 w-1.5 rounded-full bg-emerald-500" />
                            {asset.risk} Stability
                          </div>
                        </td>
                        <td className="text-right p-8 font-black tabular-nums text-base group-hover:scale-110 transition-transform duration-500 origin-right tracking-tighter">₹{asset.value.toLocaleString()}</td>
                        <td className="text-center p-8 hidden md:table-cell">
                          <div className="flex flex-col items-center gap-2">
                            <div className="flex justify-between w-24 text-[9px] font-black uppercase mb-1">
                              <span className="text-muted-foreground">Confidence</span>
                              <span className="text-emerald-600">{asset.confidence}%</span>
                            </div>
                            <div className="h-1.5 w-24 overflow-hidden rounded-full bg-muted/30 border border-border/10 flex">
                              <motion.div
                                className="h-full bg-gradient-to-r from-emerald-500 to-blue-500"
                                initial={{ width: 0 }}
                                whileInView={{ width: `${asset.confidence}%` }}
                                transition={{ duration: 1.5, delay: i * 0.1, ease: "easeOut" }}
                              />
                            </div>
                          </div>
                        </td>
                        <td className="text-right p-8">
                          <div className="inline-flex items-center gap-2 px-4 py-2 rounded-2xl text-xs font-black bg-emerald-500/10 text-emerald-600 shadow-xl shadow-emerald-500/5 group-hover:bg-emerald-600 group-hover:text-white transition-all duration-500 scale-95 group-hover:scale-105">
                            <ArrowUpRight className="h-4 w-4 group-hover:rotate-45 transition-transform" />
                            +{asset.return}%
                          </div>
                        </td>
                        <td className="text-center p-8">
                          <Button
                            size="sm"
                            className="h-10 px-6 text-[10px] font-black rounded-2xl bg-[#0A66C2] hover:bg-blue-700 text-white shadow-xl shadow-blue-500/20 group-hover:scale-110 transition-all uppercase tracking-widest border-none"
                            onClick={() => window.location.href = `/bharataiwealth/stocks/${asset.name.split(' ')[0].toUpperCase()}?risk=LOW`}
                          >
                            <Brain className="h-4 w-4 mr-2" />
                            Analyze
                          </Button>
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </CardContent>
          </Card>
        </motion.div>

        {/* AI Recommendations - Intelligence v4 */}
        <motion.div variants={scrollReveal}>
          <Card className="border-blue-500/30 bg-blue-500/5 overflow-hidden relative group">
            <div className="absolute top-0 right-0 p-12 opacity-5 group-hover:scale-125 transition-transform duration-1000">
              <Sparkles className="h-40 w-40 text-blue-600" />
            </div>
            <CardHeader className="border-b border-blue-500/10">
              <div className="flex items-center justify-between">
                <CardTitle className="text-xl font-black flex items-center gap-2 uppercase tracking-tight">
                  <Sparkles className="h-5 w-5 text-[#0A66C2] animate-pulse" />
                  AI Recommendations
                </CardTitle>
                <Badge className="bg-[#0A66C2]/10 text-[#0A66C2] border-none font-black text-[9px] uppercase tracking-widest">AI Powered</Badge>
              </div>
            </CardHeader>
            <CardContent className="pt-8">
              <div className="grid md:grid-cols-2 gap-6">
                {sipRecommendations.map((sip, i) => (
                  <div key={i} className="flex items-center justify-between p-6 bg-white/40 dark:bg-black/20 backdrop-blur-md border border-white/50 dark:border-white/10 rounded-3xl hover:border-blue-500/40 transition-all group cursor-pointer shadow-xl hover:shadow-[#0A66C2]/10 relative overflow-hidden">
                    <div className="absolute inset-0 bg-gradient-to-br from-blue-500/10 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity" />
                    <div className="relative z-10">
                      <p className="font-black text-sm uppercase tracking-tight group-hover:text-[#0A66C2] transition-colors mb-2">{sip.fund}</p>
                      <div className="flex gap-2">
                        <Badge variant="outline" className="text-[9px] border-blue-500/20 text-[#0A66C2] font-black uppercase tracking-widest">{sip.frequency} Wealth Protocol</Badge>
                        <Badge variant="outline" className="text-[9px] border-emerald-500/20 text-emerald-600 font-black uppercase tracking-widest">92% Signal</Badge>
                      </div>
                    </div>
                    <div className="flex items-center gap-6 relative z-10">
                      <div className="text-right">
                        <p className="text-[8px] font-black text-muted-foreground uppercase mb-0.5 tracking-widest">Allocation Node</p>
                        <p className="font-black text-2xl text-[#0A66C2] tabular-nums tracking-tighter">₹{sip.amount.toLocaleString()}</p>
                      </div>
                      <Button size="icon" className="bg-[#0A66C2] hover:bg-blue-700 h-12 w-12 rounded-2xl shadow-xl shadow-blue-500/30 ring-4 ring-blue-500/10 group-hover:scale-110 transition-all">
                        <Plus className="h-6 w-6" />
                      </Button>
                    </div>
                  </div>
                ))}
              </div>
            </CardContent>
          </Card>
        </motion.div>

        {/* Global Strategy Pillars */}
        <motion.div variants={scrollReveal}>
          <Card className="glass-card border-border/20 bg-muted/5">
            <CardHeader className="text-center pb-8 border-b border-border/10">
              <CardTitle className="text-base font-black flex items-center justify-center gap-2 text-muted-foreground uppercase tracking-[0.3em]">
                <Info className="h-4 w-4" />
                Strategic Stability Protocol
              </CardTitle>
            </CardHeader>
            <CardContent className="pt-10 pb-10">
              <div className="grid sm:grid-cols-3 gap-10">
                {[
                  { title: "Capital Fortress", desc: "Rigorous focus on principal preservation through sovereign instruments.", icon: Shield, color: "emerald", label: "Security" },
                  { title: "Deterministic Growth", desc: "Predictable alpha trajectories optimized for long-term compound scaling.", icon: Target, color: "blue", label: "Alpha" },
                  { title: "Fiscal Optimization", desc: "Advanced tax-harvesting algorithms for maximum net-realized returns.", icon: Brain, color: "purple", label: "Tax" },
                ].map((pillar, i) => (
                  <div key={i} className="flex flex-col items-center text-center group cursor-default">
                    <div className="relative mb-6">
                      <div className={`absolute inset-0 bg-${pillar.color}-500 blur-2xl opacity-0 group-hover:opacity-20 transition-opacity duration-500`} />
                      <div className={`h-20 w-20 rounded-[2rem] bg-${pillar.color}-500/10 flex items-center justify-center border border-${pillar.color}-500/20 group-hover:scale-110 group-hover:rotate-6 transition-all duration-500 relative z-10`}>
                        <pillar.icon className={`h-10 w-10 text-${pillar.color}-500`} />
                      </div>
                    </div>
                    <Badge variant="outline" className={`text-[8px] font-black uppercase mb-3 border-${pillar.color}-500/20 text-${pillar.color}-500 tracking-widest`}>{pillar.label}</Badge>
                    <h4 className="font-black text-lg mb-2 uppercase tracking-tight group-hover:text-foreground transition-colors">{pillar.title}</h4>
                    <p className="text-xs text-muted-foreground font-bold leading-relaxed px-4 opacity-70 tracking-wide">{pillar.desc}</p>
                  </div>
                ))}
              </div>
            </CardContent>
          </Card>
        </motion.div>

        {/* Tactical Actions Dashboard */}
        <motion.div className="flex flex-col sm:flex-row gap-6 pt-6" variants={scrollReveal}>
          <Button onClick={() => setShowAddModal(true)} className="flex-1 h-20 text-lg font-black bg-emerald-600 hover:bg-emerald-700 rounded-[2rem] shadow-2xl shadow-emerald-500/30 active:scale-95 transition-all uppercase tracking-widest border-none group overflow-hidden relative">
            <div className="absolute inset-0 bg-gradient-to-r from-white/10 to-transparent opacity-0 group-hover:opacity-100 transition-opacity" />
            <Plus className="h-6 w-6 mr-3 group-hover:rotate-90 transition-transform duration-500" />
            Initiate Position
          </Button>
          <Button variant="outline" className="flex-1 h-20 text-lg font-black border-emerald-500/30 text-emerald-600 bg-emerald-500/5 hover:bg-emerald-500/10 rounded-[2rem] active:scale-95 transition-all uppercase tracking-widest group relative overflow-hidden" onClick={() => window.open('/bharataiwealth/portfolio', '_self')}>
            <div className="absolute inset-0 bg-gradient-to-r from-emerald-500/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity" />
            <Eye className="h-6 w-6 mr-3 group-hover:scale-125 transition-transform duration-500" />
            Global Dashboard
          </Button>
        </motion.div>

        {/* Intelligence Add Modal */}
        {showAddModal && (
          <div className="fixed inset-0 bg-black/80 backdrop-blur-md flex items-center justify-center z-[100] p-4">
            <motion.div
              initial={{ opacity: 0, scale: 0.8, y: 40 }}
              animate={{ opacity: 1, scale: 1, y: 0 }}
              className="w-full max-w-lg"
            >
              <Card className="glass-card shadow-2xl border-emerald-500/30 bg-white/90 dark:bg-black/90 pb-4 overflow-hidden">
                <div className="h-2 w-full bg-emerald-500" />
                <CardHeader className="flex flex-row items-center justify-between border-b border-border/10 pb-6 px-8 pt-8">
                  <div className="flex items-center gap-4">
                    <div className="h-12 w-12 rounded-2xl bg-emerald-500/10 flex items-center justify-center border border-emerald-500/20">
                      <Shield className="h-6 w-6 text-emerald-600" />
                    </div>
                    <div>
                      <CardTitle className="text-2xl font-black uppercase tracking-tight">Expand Stability</CardTitle>
                      <p className="text-[10px] font-black text-muted-foreground uppercase tracking-widest">Stability Tier Asset Integration</p>
                    </div>
                  </div>
                  <Button variant="ghost" size="icon" className="rounded-full hover:bg-muted h-10 w-10" onClick={() => setShowAddModal(false)}>
                    <X className="h-6 w-6" />
                  </Button>
                </CardHeader>
                <CardContent className="space-y-8 pt-10 px-8">
                  <div className="space-y-3">
                    <label className="text-[10px] font-black text-muted-foreground uppercase tracking-[0.2em] ml-1">Asset Architecture</label>
                    <select className="w-full h-14 px-6 rounded-2xl border-2 border-border bg-muted/30 focus:border-emerald-500/50 focus:outline-none transition-all font-black uppercase text-xs tracking-widest appearance-none cursor-pointer">
                      <option>Sovereign Fixed Deposit</option>
                      <option>Sovereign Gold Bonds (SGB)</option>
                      <option>Liquid Alpha Mutual Fund</option>
                      <option>Government PPF / EPF Hub</option>
                    </select>
                  </div>
                  <div className="space-y-3">
                    <label className="text-[10px] font-black text-muted-foreground uppercase tracking-[0.2em] ml-1">Node Identifier</label>
                    <Input placeholder="e.g. SBI TIER 1 FIXED DEPOSIT" className="h-14 rounded-2xl border-2 border-border bg-muted/30 font-black uppercase px-6 text-xs tracking-widest focus:border-emerald-500/50" />
                  </div>
                  <div className="space-y-3">
                    <label className="text-[10px] font-black text-muted-foreground uppercase tracking-[0.2em] ml-1">Capital Liquidity</label>
                    <div className="relative">
                      <span className="absolute left-6 top-1/2 -translate-y-1/2 font-black text-emerald-600 text-lg">₹</span>
                      <Input type="number" placeholder="50,000.00" className="h-14 pl-12 rounded-2xl border-2 border-border bg-muted/30 font-black text-xl tracking-tighter focus:border-emerald-500/50" />
                    </div>
                  </div>
                  <Button className="w-full h-16 bg-emerald-600 hover:bg-emerald-700 text-lg font-black rounded-3xl shadow-2xl shadow-emerald-500/30 mt-4 uppercase tracking-[0.2em] border-none" onClick={() => setShowAddModal(false)}>
                    Integrate Node
                  </Button>
                </CardContent>
              </Card>
            </motion.div>
          </div>
        )}
      </motion.div>
    </AppShell>
  )
}
