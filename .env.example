# Bharat AI Wealth - Environment Variables Example
# Copy this file to .env and fill in your actual values

# ==================== Backend Configuration ====================

# Database Configuration
DATABASE_URL=jdbc:postgresql://localhost:5432/wealthdb
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres

JWT_SECRET=koi_bhi_32_characters_ka_random_string_yahan_type_karein
AUDIT_HMAC_KEY=koi_bhi_32_characters_ka_random_string_yahan_type_karein
ENCRYPTION_MASTER_KEY=koi_bhi_32_characters_ka_random_string_yahan_type_karein
ML_SERVICE_API_KEY=koi_bhi_random_api_key_yahan_type_karein

# JWT Configuration (IMPORTANT: Use strong, unique values in production)
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_long_here
AUDIT_HMAC_KEY=your_audit_hmac_key_minimum_32_characters_long_here

# Bank-Level Security Configuration
# AES-256 Encryption Master Key (CRITICAL: Generate using: openssl rand -base64 32)
ENCRYPTION_MASTER_KEY=your_encryption_master_key_32_bytes_base64_encoded

# API Keys for Service-to-Service Communication
ML_SERVICE_API_KEY=your_ml_service_api_key_here

# ==================== Frontend Configuration ====================

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_API_TIMEOUT=30000
NEXT_PUBLIC_ENABLE_MFA=true

# ==================== ML Service Configuration ====================

# Python ML Service
ML_SERVICE_PORT=8000
ML_SERVICE_HOST=localhost

# ==================== Production Notes ====================
# 1. Never commit actual secrets to version control
# 2. Use environment-specific values
# 3. Rotate secrets regularly (every 90 days recommended)
# 4. Use secret management tools (AWS Secrets Manager, Azure Key Vault, etc.)
# 5. Generate strong random values for all keys

# ==================== How to Generate Secrets ====================
# JWT_SECRET (32+ characters):
#   openssl rand -base64 32
#
# ENCRYPTION_MASTER_KEY (exactly 32 bytes for AES-256):
#   openssl rand -base64 32
#
# API_KEY (random hex):
#   openssl rand -hex 32
#
# Windows PowerShell:
#   [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
